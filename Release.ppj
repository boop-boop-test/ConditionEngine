<?xml version='1.0'?>
<!-- Compiles ConditionEngine.psc with Pyro: pyro.exe -i Release.ppj
     Imports use the SKSE/Skyrim script sources installed by the parent project's build. -->
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output="contrib/Distribution/PapyrusRelease"
    Optimize="true"
    Release="true"
    Anonymize="true"
    Final="true">
	<Imports>
		<Import>..\build\release-msvc\vcpkg_installed\x64-windows-skse\contrib\papyrus\skse</Import>
		<Import>..\build\release-msvc\vcpkg_installed\x64-windows-skse\contrib\papyrus\skyrim</Import>
	</Imports>
	<Folders>
		<Folder>.\contrib\Distribution\PapyrusSources</Folder>
	</Folders>
</PapyrusProject>
